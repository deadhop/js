{
  "name": "@deadhop/network-ui",
  "version": "0.1.0",
  "private": true,
  "description": "The Network views of a deadhop service's dashboard: relays, proxies, routing rules, relay health and the privacy audit (Svelte 5).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./schemas": {
      "deadhop-source": "./src/lib/schemas.ts",
      "default": "./src/lib/schemas.ts"
    },
    "./lib/*": {
      "deadhop-source": "./src/lib/*.ts",
      "default": "./src/lib/*.ts"
    },
    "./components/*": {
      "svelte": "./src/components/*",
      "default": "./src/components/*"
    },
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@deadhop/client": "0.1.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "svelte": "^5.58.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@vitest/coverage-v8": "^5.1.1",
    "jsdom": "^31.0.1",
    "svelte": "^5.58.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
